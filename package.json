{
  "name": "kube-dependency",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:topology-remote": "next dev apps/topology-remote --webpack -p 3001",
    "dev:rbac-remote": "next dev apps/rbac-remote --webpack -p 3002",
    "dev:images-remote": "next dev apps/images-remote --webpack -p 3003",
    "dev:manifests-remote": "next dev apps/manifests-remote --webpack -p 3004",
    "dev:security-remote": "next dev apps/security-remote --webpack -p 3005",
    "build": "next build --webpack",
    "build:topology-remote": "next build apps/topology-remote --webpack",
    "build:rbac-remote": "next build apps/rbac-remote --webpack",
    "build:images-remote": "next build apps/images-remote --webpack",
    "build:manifests-remote": "next build apps/manifests-remote --webpack",
    "build:security-remote": "next build apps/security-remote --webpack",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "extension:build": "node vscode-extension/esbuild.mjs",
    "extension:watch": "node vscode-extension/esbuild.mjs --watch",
    "extension:package": "cd vscode-extension && npx --yes @vscode/vsce package --no-git-tag-version",
    "extension:package:bundle": "./scripts/package-extension-bundle.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@kubernetes/client-node": "^2.0.0",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.0",
    "js-yaml": "^4.3.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.137.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
